# 예시 환경변수 파일 — 실제 값은 .env.local 에 작성 (git 추적 제외)

# 사이트 절대 URL — 메타데이터(OG)·robots·canonical 의 절대경로 생성에 사용
# 미설정 시 https://kibo-ktop.vercel.app 폴백
NEXT_PUBLIC_SITE_URL=https://kibo-ktop.vercel.app

# 퍼블리싱 인덱스의 저장소·FE 전달용 링크 전용 설정 (사이트 메타데이터와 무관)
# 미설정 시 예시 저장소로 폴백
NEXT_PUBLIC_REPOSITORY_URL=https://github.com/fromex-koh/kibo-ktop
